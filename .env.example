# ──────────────────────────────────────────────────────────────────────
# SOLO SECRETOS. El resto de la configuración (LLM_URL, MODEL_NAME, RAG,
# rutas, etc.) está en constants.py — edítala ahí, no aquí.
#
# Copia este fichero a `.env` y rellena los valores.
# ──────────────────────────────────────────────────────────────────────

# Clave de API del LLM (Ollama Cloud). Se envía como `Authorization: Bearer`.
LLM_API_KEY=

# Token de HuggingFace (opcional; solo si el modelo de embeddings requiere
# descarga autenticada).
HF_TOKEN=
