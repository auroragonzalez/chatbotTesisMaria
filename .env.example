# ── Cloud LLM endpoint ───────────────────────────────────────────────────────
# Ollama Cloud (endpoint OpenAI-compatible).
# Verifica la URL en tu panel de Ollama si es distinta.
LLM_URL=https://ollama.com/v1/chat/completions
MODEL_NAME=gemma3:27b-cloud

# Clave de API del proveedor (Ollama Cloud). Se envía como `Authorization: Bearer`.
LLM_API_KEY=

# ── Embeddings (HuggingFace, se descarga en el primer arranque) ──────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-base
HF_TOKEN=

# ── RAG ──────────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=4
MAX_TOKENS=512
TEMPERATURE=0.3
