.env

# Python build artifacts
__pycache__/
*.pyc

# macOS junk (e.g. from unzipped corpus archives)
.DS_Store
__MACOSX/

# LibreOffice/OpenOffice lock files
.~lock.*#

# Entornos virtuales
.venv/
.venv-eval/

# Backups del preprocesado de horarios (reversibles)
*.orig

